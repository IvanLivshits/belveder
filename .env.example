# apps/bot
BOT_TOKEN=123456:ABC-DEF
WEBAPP_URL=https://your-miniapp.example.com
# Where /paysupport and /terms send players with payment questions (a @username or an email)
SUPPORT_CONTACT=@your_support
# Secret token Telegram sends in X-Telegram-Bot-Api-Secret-Token (any random string)
WEBHOOK_SECRET=change-me
# Public URL of the bot server; webhook is set to $WEBHOOK_URL/webhook
WEBHOOK_URL=https://your-bot.example.com
PORT=8787

# apps/miniapp (optional, in apps/miniapp/.env.local): the bot server that issues tip invoices.
# Defaults to the production bot worker.
# VITE_BOT_URL=https://your-bot.example.com
