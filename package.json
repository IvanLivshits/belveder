{
  "name": "belvedere",
  "private": true,
  "packageManager": "bun@1.4.2",
  "engines": { "bun": ">=1.4.2" },
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "bun run --cwd apps/miniapp dev",
    "build": "bun run content:build && bun run --cwd apps/miniapp build",
    "test": "bun test",
    "typecheck": "bun run content:build && tsc -b",
    "content:build": "bun run packages/validator/src/build-content.ts content/belvedere content/belvedere/build/world.json",
    "validate": "bun run content:build && bun run packages/validator/src/cli.ts content/belvedere/build/world.json assets/assets.json",
    "assets": "python3 -I tools/assets/convert.py",
    "bot": "bun run --cwd apps/bot start",
    "bot:webhook": "bun run --cwd apps/bot set-webhook"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0"
  }
}
