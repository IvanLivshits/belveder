{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": ".",
    "outDir": "dist/types",
    "emitDeclarationOnly": true,
    "noEmit": false,
    "declaration": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "resolveJsonModule": true,
    "types": [
      "@types/bun",
      "vite/client"
    ]
  },
  "include": [
    "src",
    "vite.config.ts"
  ],
  "references": [
    {
      "path": "../../packages/content-schema"
    },
    {
      "path": "../../packages/engine"
    },
    {
      "path": "../../packages/ui-kit"
    }
  ]
}
